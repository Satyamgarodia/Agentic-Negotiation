# Minimal env: ONLY secrets. Everything else is hardcoded in server.ts.
# Keep exactly these 4 variables in the Cloud Run console (plus PORT, which
# Cloud Run injects automatically). Delete the rest (SQL_DB_NAME, APP_URL,
# LIVEKIT_URL, etc.) — the server uses hardcoded defaults for those.

GEMINI_API_KEY="MY_GEMINI_API_KEY"
META_ACCESS_TOKEN="MY_META_ACCESS_TOKEN"
LIVEKIT_API_KEY="MY_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="MY_LIVEKIT_API_SECRET"

# --- Optional overrides (do NOT set unless you need to change the default) ---
# MEDIA_ANNOUNCE_IP: public UDP-reachable IP announced in the SDP answer.
#   Default "" (unset). Needed only for direct Meta RTP audio via a UDP bridge.
# APP_URL: public service URL for webhook hints.
#   Default "https://gemini-call-link-387274718809.us-central1.run.app".
# LIVEKIT_URL: LiveKit Cloud endpoint.
#   Default "wss://agent-negotiation-wt32uzjo.livekit.cloud".
# MEDIA_ANNOUNCE_IP=""
# APP_URL=""
# LIVEKIT_URL=""
